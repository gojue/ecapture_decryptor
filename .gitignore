# Binaries for programs and plugins
bin/*
*.exe
*.exe~
*.dll
*.so
*.dylib

# Static library files
lib/*

# Header files (generated)
include/*

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# Build artifacts
dist/*

# Test results
test/result/*.har
test/result/*.json

# C demo test output (executables are now in bin/)
examples/c_demo/*.json
examples/c_demo/*.har

/dist/
